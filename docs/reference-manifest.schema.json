{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AxelMcKenna/RMX-1000-Clone/reference-manifest.schema.json",
  "title": "RMX reference capture session",
  "type": "object",
  "required": ["schema_version", "kind", "status", "stimuli", "cases", "captures", "calibration"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "rmx-reference-session"},
    "status": {"enum": ["awaiting_reference", "partial", "captured", "reviewed"]},
    "stimuli": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "path", "sha256", "rate", "frames", "active_seconds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "rate": {"type": "integer", "minimum": 8000, "maximum": 192000},
          "frames": {"type": "integer", "minimum": 1},
          "active_seconds": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2}
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "parameters", "preset", "stimuli", "hardware_controls"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "parameters": {"type": "object", "additionalProperties": {"type": "number"}},
          "preset": {"type": "string", "minLength": 1},
          "stimuli": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "hardware_controls": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["not_captured", "documented"]}}}
        }
      }
    },
    "calibration": {
      "type": "object", "required": ["candidate_delay_frames", "verified"],
      "properties": {"candidate_delay_frames": {"type": "integer"}, "verified": {"type": "boolean"}, "note": {"type": "string"}}
    },
    "captures": {
      "type": "array", "items": {
        "type": "object",
        "required": ["case_id", "stimulus_id", "path", "sha256", "rate", "frames", "origin", "captured_at_utc", "setup", "control_log", "calibration_report"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "stimulus_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "rate": {"type": "integer", "minimum": 8000, "maximum": 192000},
          "frames": {"type": "integer", "minimum": 1},
          "origin": {"enum": ["physical_rmx1000", "software", "bypass_loopback"]},
          "captured_at_utc": {"type": "string", "format": "date-time"},
          "setup": {
            "type": "object", "required": ["device", "firmware_or_commit", "interface", "routing", "clock", "recording_app"],
            "properties": {
              "device": {"type": "string", "minLength": 1},
              "firmware_or_commit": {"type": "string", "minLength": 1},
              "interface": {"type": "string", "minLength": 1},
              "routing": {"type": "string", "minLength": 1},
              "clock": {"type": "string", "minLength": 1},
              "recording_app": {"type": "string", "minLength": 1}
            }
          },
          "control_log": {"type": "string", "minLength": 1},
          "calibration_report": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
