(version 1)
(rule "General copper clearance" (constraint clearance (min 0.20mm)))
(rule "Inherited VSSOP adjacent stock lands"
 (condition "A.Type == 'Pad' && B.Type == 'Pad' && ((A.memberOfFootprint('A_U101') && B.memberOfFootprint('A_U101')) || (A.memberOfFootprint('A_U102') && B.memberOfFootprint('A_U102')) || (A.memberOfFootprint('A_U105') && B.memberOfFootprint('A_U105')) || (A.memberOfFootprint('A_U106') && B.memberOfFootprint('A_U106')))")
 (constraint clearance (min 0.15mm)))

(rule "Main mount A_H5 conductive receiving disc r2.4 copper pads" (layer F.Cu) (condition "A.Type == 'Pad' && A.intersectsArea('Main mount A_H5 conductive receiving disc r2.4') && (A.Pad_Type != 'NPTH, mechanical' || A.Pad_Shape != 'Circle' || A.Size_X > A.Hole_Size_X || A.Size_Y > A.Hole_Size_Y)") (constraint disallow pad))

(rule "Main mount D_H3 conductive receiving disc r2.4 copper pads" (layer F.Cu) (condition "A.Type == 'Pad' && A.intersectsArea('Main mount D_H3 conductive receiving disc r2.4') && (A.Pad_Type != 'NPTH, mechanical' || A.Pad_Shape != 'Circle' || A.Size_X > A.Hole_Size_X || A.Size_Y > A.Hole_Size_Y)") (constraint disallow pad))

(rule "Main mount A_H2 conductive receiving disc r2.4 copper pads" (layer F.Cu) (condition "A.Type == 'Pad' && A.intersectsArea('Main mount A_H2 conductive receiving disc r2.4') && (A.Pad_Type != 'NPTH, mechanical' || A.Pad_Shape != 'Circle' || A.Size_X > A.Hole_Size_X || A.Size_Y > A.Hole_Size_Y)") (constraint disallow pad))

(rule "Main mount A_H1 conductive receiving disc r2.4 copper pads" (layer F.Cu) (condition "A.Type == 'Pad' && A.intersectsArea('Main mount A_H1 conductive receiving disc r2.4') && (A.Pad_Type != 'NPTH, mechanical' || A.Pad_Shape != 'Circle' || A.Size_X > A.Hole_Size_X || A.Size_Y > A.Hole_Size_Y)") (constraint disallow pad))

(rule "Main mount A_H6 conductive receiving disc r2.4 copper pads" (layer F.Cu) (condition "A.Type == 'Pad' && A.intersectsArea('Main mount A_H6 conductive receiving disc r2.4') && (A.Pad_Type != 'NPTH, mechanical' || A.Pad_Shape != 'Circle' || A.Size_X > A.Hole_Size_X || A.Size_Y > A.Hole_Size_Y)") (constraint disallow pad))

(rule "Main mount A_H4 conductive receiving disc r2.4 copper pads" (layer F.Cu) (condition "A.Type == 'Pad' && A.intersectsArea('Main mount A_H4 conductive receiving disc r2.4') && (A.Pad_Type != 'NPTH, mechanical' || A.Pad_Shape != 'Circle' || A.Size_X > A.Hole_Size_X || A.Size_Y > A.Hole_Size_Y)") (constraint disallow pad))

(rule "Main mount D_H1 conductive receiving disc r2.4 copper pads" (layer F.Cu) (condition "A.Type == 'Pad' && A.intersectsArea('Main mount D_H1 conductive receiving disc r2.4') && (A.Pad_Type != 'NPTH, mechanical' || A.Pad_Shape != 'Circle' || A.Size_X > A.Hole_Size_X || A.Size_Y > A.Hole_Size_Y)") (constraint disallow pad))

(rule "Main mount D_H4 conductive receiving disc r2.4 copper pads" (layer F.Cu) (condition "A.Type == 'Pad' && A.intersectsArea('Main mount D_H4 conductive receiving disc r2.4') && (A.Pad_Type != 'NPTH, mechanical' || A.Pad_Shape != 'Circle' || A.Size_X > A.Hole_Size_X || A.Size_Y > A.Hole_Size_Y)") (constraint disallow pad))

(rule "Main mount A_H3 conductive receiving disc r2.4 copper pads" (layer F.Cu) (condition "A.Type == 'Pad' && A.intersectsArea('Main mount A_H3 conductive receiving disc r2.4') && (A.Pad_Type != 'NPTH, mechanical' || A.Pad_Shape != 'Circle' || A.Size_X > A.Hole_Size_X || A.Size_Y > A.Hole_Size_Y)") (constraint disallow pad))
