module pf_relative_receiver(){for(i=[0:1]){pf_sweep([pf_receiver_tail[i],pf_receiver_cut[i]],1.005);intersection(){pf_sweep([pf_stub_start[i],pf_receiver_cut[i]],1.1813);pf_above(11.2-.305);}}}
